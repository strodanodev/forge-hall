# Copy this file to `.env` and fill it in. `.env` is only read by `npm run migrate`.
# NEVER commit real values. On Vercel, set the same names under
# Project Settings -> Environment Variables (or with `vercel env add`).

# Neon POOLED connection string: in the Neon dashboard click Connect, switch
# "Connection pooling" on, and copy the string (its host contains "-pooler").
# Paste it exactly as shown, for example:
#   postgresql://USER:PASSWORD@ep-example-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Optional. Chain that sign-in messages are bound to.
# 4441 = LitVM Liteforge testnet (this is the default when unset).
# SIWE_CHAIN_ID=4441

# Required on Vercel (every environment: Production and Preview), optional elsewhere.
# Comma-separated hosts, written exactly as they appear in the browser address bar
# (add ":port" only if it is not 80/443). When set, sign-in works only on these hosts;
# when unset, any host is accepted locally and the API answers 503 on Vercel.
# ALLOWED_HOSTS=forge.example.com

# There is no SESSION_SECRET: sessions are random tokens stored hashed in the
# database, so nothing needs to be signed with a server-side key.
